{
  "type": "CORE:RecipeLink",
  "_blueprintPath_": "/plugins/counter/blueprints/Counter",
  "initialUiRecipe": {
    "name": "CounterVariants",
    "type": "CORE:UiRecipe",
    "description": "Renders both named counter recipes against the same document",
    "plugin": "@development-framework/dm-core-plugins/stack",
    "config": {
      "type": "PLUGINS:dm-core-plugins/stack/StackPluginConfig",
      "direction": "vertical",
      "spacing": 2,
      "items": [
        {
          "type": "CORE:ReferenceViewConfig",
          "scope": "self",
          "recipe": "SingleValueIncrement"
        },
        {
          "type": "CORE:ReferenceViewConfig",
          "scope": "self",
          "recipe": "DoubleValueIncrement"
        }
      ]
    }
  },
  "uiRecipes": [
    {
      "name": "SingleValueIncrement",
      "type": "CORE:UiRecipe",
      "description": "Counter stepping by one",
      "plugin": "@development-framework/dm-core-plugins/counter",
      "config": {
        "type": "PLUGINS:dm-core-plugins/counter/CounterPluginConfig",
        "attribute": "count",
        "label": "Clicks",
        "incrementValue": 1,
        "decrementValue": 1
      }
    },
    {
      "name": "DoubleValueIncrement",
      "type": "CORE:UiRecipe",
      "description": "Counter stepping by two",
      "plugin": "@development-framework/dm-core-plugins/counter",
      "config": {
        "type": "PLUGINS:dm-core-plugins/counter/CounterPluginConfig",
        "attribute": "count",
        "label": "Double Clicks",
        "incrementValue": 2,
        "decrementValue": 2
      }
    }
  ]
}
